{
  "name": "atelier-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "render": "tsx scripts/render-seeds.ts",
    "gen:modes": "tsx scripts/gen-modes.ts > src/engine/modeTable.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:xb": "node scripts/smoke-xb.mjs",
    "render:browser": "node scripts/render-browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.61.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "description": "物理モデルの音色空間を探って自分だけの楽器を創り、演奏し、DAW へ持ち出すブラウザアプリ",
  "license": "MIT"
}
